#!/usr/bin/env python3
"""EIU - Egyptian Internet Usage.

Tracks how much data this computer uses per day, against your home internet
plan, and tells you when the quota renews. Built for Omarchy's bar but works
as a plain CLI too.

  eiu                     status for the current cycle
  eiu status [--json]     same, or machine readable
  eiu collect [--status]  sample interface counters (the bar runs this every minute)
  eiu setup               interactive setup (provider, plan, renewal)
  eiu set <key> <value>   change one setting (see `eiu set --help`)
  eiu detect [--json]     show how the provider was detected
  eiu adjust <amount>     correct this cycle to match your ISP's figure (e.g. 120GB)
  eiu adjust --clear      remove the correction
  eiu history [--json]    totals of previous cycles
  eiu debug on|off        let EIU run outside Egypt (for testing)
  eiu providers [--json]  list known providers and their plans
  eiu doctor              check that everything is in place
  eiu reset --yes         forget all collected data
"""

import datetime as dt
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

VERSION = "1.0.0"

HOME = os.path.expanduser("~")
CONFIG_DIR = os.environ.get("EIU_CONFIG_DIR", os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "eiu"))
DATA_DIR = os.environ.get("EIU_DATA_DIR", os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "eiu"))
STATE_DIR = os.environ.get("EIU_STATE_DIR", os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "eiu"))
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
LEDGER_FILE = os.path.join(DATA_DIR, "ledger.json")
STATUS_FILE = os.path.join(STATE_DIR, "status.json")
GEO_FILE = os.path.join(STATE_DIR, "geo.json")
LOCK_FILE = os.path.join(STATE_DIR, "lock")

GEO_TTL = 6 * 3600          # re-check location every 6 hours
GEO_FAIL_TTL = 15 * 60      # retry sooner after a failed lookup
LEDGER_KEEP_DAYS = 400      # keep a bit over a year of daily history

# Interfaces that never carry ISP traffic of their own (virtual, tunnels,
# containers). Tunnel traffic also crosses the physical link, so counting it
# would double it.
SKIP_IFACE = re.compile(r"^(lo|docker|br-|veth|virbr|vnet|tailscale|tun|tap|wg|zt|cni|flannel|podman|lxc|kube|dummy|ifb|sit|ip6tnl|gre|nlmon|wwan-dummy)")

PLANS_GB = [200, 300, 400, 500, 600, 700, 800, 900, 1000]

# Known Egyptian home ISPs. ASNs come from the RIR registry; SSID patterns are
# the default names the ISPs' routers ship with. Renewal is per account in
# Egypt (WE renews 30 days after the last renewal, the others on a monthly
# date shown in their apps), so `renewal` is only the default offered in setup.
PROVIDERS = {
    "etisalat": {
        "name": "e& (Etisalat Misr)",
        "short": "e&",
        "asns": [36992],
        "keywords": ["etisalat", "e&", "eand", "etisalat misr"],
        "ssid": r"^(etisalat|e&|eand|e_and)",
        "renewal": {"mode": "monthly", "day": 15},
        "renewal_note": "e& home internet renews on the 15th of every month.",
        "app": "My e& app or *500# from the landline account",
    },
    "we": {
        "name": "WE (Telecom Egypt / TE Data)",
        "short": "WE",
        "asns": [8452, 25576],
        "keywords": ["te data", "tedata", "telecom egypt", "te-data"],
        "ssid": r"^(we[_\-\s]|we$|te[_\-\s]?data|tedata|vdsl_we|my we)",
        "renewal": {"mode": "every30", "day": 1},
        "renewal_note": "WE renews 30 days after your last renewal; renewing early resets the cycle to today.",
        "app": "My WE app or my.te.eg",
    },
    "orange": {
